								{
									"_type": "span",
									"_key": "s1",
									"text": "I've hired, grown and mentored distributed teams across Israel, France, Spain, Portugal and Vietnam — most recently leading them into agentic SDLC practices with Claude Code and Cursor, without lowering the bar on quality."
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
