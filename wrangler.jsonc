{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "selenium79",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "selenium79",
			"database_id": "18945354-3284-4a0b-9481-d94250ceb4e7",
		},
	],
	// Astro sessions store (auto-provisioned on first deploy; pinned to reuse it)
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "bf869b2be6c84f3eb05c5a6a6cdd62c9",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
