---
export const prerender = false;

import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

const result = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 50,
});
if (result.error) {
	return new Response("Could not load the blog", { status: 500 });
}
const { entries: posts } = result;
if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);

const dateFmt = new Intl.DateTimeFormat("en", { dateStyle: "long" });
---

<Base title="Blog">
	<section class="blog">
		<h1>Blog</h1>
		{
			posts.length > 0 ? (
				<ul class="posts">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}`}>
								{post.data.publishedAt && (
									<time datetime={post.data.publishedAt.toISOString()}>
										{dateFmt.format(post.data.publishedAt)}
									</time>
								)}
								<h2 {...post.edit.title}>{post.data.title}</h2>
								{post.data.excerpt && (
									<p {...post.edit.excerpt}>{post.data.excerpt}</p>
								)}
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty">
					No posts yet. <a href="/_emdash/admin/content/posts/new">Write one</a>.
				</p>
			)
		}
	</section>
</Base>

<style>
	.blog {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-4xl);
	}

	h1 {
		font-size: var(--font-size-3xl);
		margin-bottom: var(--spacing-2xl);
	}

	.posts {
		list-style: none;
		padding: 0;
		display: grid;
		gap: var(--spacing-2xl);
	}

	.posts a {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	time {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
	}

	h2 {
		font-family: var(--font-heading);
		font-weight: var(--font-weight-heading);
		font-size: var(--font-size-2xl);
		margin: var(--spacing-xs) 0;
	}

	.posts a:hover h2 {
		color: var(--color-brand);
	}

	.posts p,
	.empty {
		color: var(--color-muted);
	}
</style>
