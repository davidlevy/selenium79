---
export const prerender = false;

import { decodeSlug, getEmDashEntry, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: post, error, cacheHint } = await getEmDashEntry("posts", slug);
if (error) return new Response("Could not load the post", { status: 500 });
if (!post) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(post, {
	siteUrl: Astro.url.origin,
	path: `/blog/${slug}`,
	defaultDescription: post.data.excerpt,
	defaultOgImage: post.data.featured_image?.src,
});
const date = post.data.publishedAt;
// `content` is Portable Text in the seed schema but a plain text field in
// production: render plain text as paragraphs, Portable Text as usual.
const body: unknown = post.data.content;
const paragraphs =
	typeof body === "string"
		? body.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean)
		: null;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="post">
		<header>
			{
				date && (
					<time datetime={date.toISOString()}>
						{new Intl.DateTimeFormat("en", { dateStyle: "long" }).format(date)}
					</time>
				)
			}
			<h1 {...post.edit.title}>{post.data.title}</h1>
			{post.data.excerpt && <p class="excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>}
		</header>

		{
			post.data.featured_image && (
				<div class="featured-image" {...post.edit.featured_image}>
					<Image image={post.data.featured_image} />
				</div>
			)
		}

		<div class="content" {...post.edit.content}>
			{
				paragraphs ? (
					paragraphs.map((p) => <p set:text={p} />)
				) : (
					<PortableText value={post.data.content} />
				)
			}
		</div>
	</article>
</Base>

<style>
	.post {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-4xl);
	}

	time {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
	}

	h1 {
		font-family: var(--font-heading);
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		margin: var(--spacing-sm) 0 var(--spacing-lg);
	}

	.excerpt {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		margin-bottom: var(--spacing-2xl);
	}

	.featured-image {
		margin-bottom: var(--spacing-3xl);
	}

	.featured-image img {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
	}

	.content {
		line-height: var(--leading-relaxed);
	}

	.content :global(p) {
		white-space: pre-line;
	}

	.content :global(p),
	.content :global(ul),
	.content :global(ol) {
		margin-bottom: 1.5em;
	}

	.content :global(ul),
	.content :global(ol) {
		padding-inline-start: 1.25em;
	}

	.content :global(h2),
	.content :global(h3) {
		font-family: var(--font-heading);
		font-weight: var(--font-weight-heading);
		margin: 2em 0 0.75em;
	}

	.content :global(h2) {
		font-size: var(--font-size-2xl);
	}

	.content :global(h3) {
		font-size: var(--font-size-xl);
	}

	.content :global(blockquote) {
		margin: 2em 0;
		padding-inline-start: var(--spacing-xl);
		border-inline-start: 2px solid var(--color-brand);
		color: var(--color-muted);
		font-family: var(--font-heading);
		font-style: italic;
	}

	.content :global(img) {
		margin: 2em 0;
		border-radius: var(--radius);
	}

	@media (max-width: 768px) {
		h1 {
			font-size: var(--font-size-3xl);
		}
	}
</style>
