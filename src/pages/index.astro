---
import { getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import HeroKeys from "../components/HeroKeys.astro";
import SocialButtons from "../components/SocialButtons.astro";
import Arrow from "../components/Arrow.astro";
import MusicGrid from "../components/MusicGrid.astro";
import { profile } from "../profile";

const [settings, projectsResult, experienceResult, aboutResult, musicResult] = await Promise.all([
	getSiteSettings(),
	getEmDashCollection("projects", { orderBy: { published_at: "asc" }, limit: 6 }),
	getEmDashCollection("experience", { limit: 20 }),
	getEmDashEntry("pages", "about"),
	getEmDashCollection("music", { limit: 50 }),
]);
if (projectsResult.error || experienceResult.error || aboutResult.error || musicResult.error) {
	return new Response("Could not load the site", { status: 500 });
}
if (Astro.cache?.enabled) {
	Astro.cache.set(projectsResult.cacheHint);
	Astro.cache.set(experienceResult.cacheHint);
	Astro.cache.set(aboutResult.cacheHint);
	Astro.cache.set(musicResult.cacheHint);
}
const about = aboutResult.entry;
const tracks = [...musicResult.entries].sort((a, b) => (a.data.sort ?? 99) - (b.data.sort ?? 99));
const projects = projectsResult.entries;
const roles = [...experienceResult.entries].sort(
	(a, b) => (a.data.sort ?? 99) - (b.data.sort ?? 99),
);
const name = settings?.title || "Your Name";
const linkedin = settings?.social?.linkedin;
const github = settings?.social?.github;
const twitter = settings?.social?.twitter;
---

<Base>
	<div class="hero wrap">
	<section class="intro">
		<p class="mono intro-eyebrow">
			<span class="pulse" aria-hidden="true"></span>{profile.availability}
		</p>
		<h1 class="intro-name">{name}</h1>
		<p class="intro-lede">{profile.lede}</p>
		<div class="intro-actions">
			<SocialButtons linkedin={linkedin} github={github} twitter={twitter} email={profile.email} />
		</div>
	</section>

	<div class="hero-fig">
		<HeroKeys />
	</div>
	</div>

	{
		roles.length > 0 && (
			<section id="experience" class="wrap section">
				<header class="section-head framed">
					<span class="mono">01</span>
					<h2>Experience</h2>
				</header>
				<ol class="roles cells">
					{roles.map((r) => (
						<li class="role">
							<div class="role-top">
								{r.data.logo ? (
									<img class="role-logo" src={r.data.logo} alt={r.data.company} loading="lazy" />
								) : (
									<span class="role-logo-text">{r.data.company}</span>
								)}
								<span class="role-when mono">{r.data.period}</span>
							</div>
							<div class="role-body">
								<h3 class="role-title" {...r.edit.title}>{r.data.title}</h3>
								<p class="role-at">
									{r.data.company_url ? (
										<a href={r.data.company_url} target="_blank" rel="noopener noreferrer">
											{r.data.company} <Arrow />
										</a>
									) : (
										<span {...r.edit.company}>{r.data.company}</span>
									)}
									{r.data.location && <span class="role-where"> · {r.data.location}</span>}
								</p>
							</div>
							{r.data.stack && <p class="role-stack mono" {...r.edit.stack}>{r.data.stack}</p>}
						</li>
					))}
				</ol>
			</section>
		)
	}

	{
		projects.length > 0 && (
			<section id="work" class="wrap section">
				<header class="section-head framed">
					<span class="mono">02</span>
					<h2>Personal projects</h2>
				</header>
				<div class="grid cells">
					{projects.map((p) => (
						<ProjectCard
							title={p.data.title}
							summary={p.data.summary}
							featuredImage={p.data.featured_image}
							href={p.data.url || undefined}
							client={p.data.client}
							year={p.data.year}
							video={p.data.video}
							edit={p.edit}
						/>
					))}
				</div>
			</section>
		)
	}

	<section id="about" class="wrap section">
		<header class="section-head">
			<span class="mono">03</span>
			<h2>About</h2>
		</header>
		<div class="about">
			<div class="about-text" {...about?.edit.content}>
				{about?.data.content && <PortableText value={about.data.content} />}
			</div>
			<aside>
				<p class="mono about-label">Skills</p>
				<ul class="skills">
					{profile.skills.map((s) => <li>{s}</li>)}
				</ul>
			</aside>
		</div>
		<div class="cells facts">
			<div class="fact">
				<p class="mono fact-label">Education</p>
				<ul>
					{profile.education.map((e) => (
						<li>
							<span class="fact-main">{e.title}</span>
							<span class="fact-sub">{e.school}</span>
							<span class="fact-meta mono">{e.year}</span>
						</li>
					))}
				</ul>
			</div>
			<div class="fact">
				<p class="mono fact-label">Languages</p>
				<ul class="langs">
					{profile.languages.map((l) => (
						<li>
							<span class="fact-main">{l.name}</span>
							<span class="fact-meta mono">{l.level}</span>
						</li>
					))}
				</ul>
			</div>
			<div class="fact">
				<p class="mono fact-label">Beyond code</p>
				<ul>
					{profile.beyondCode.map((b) => (
						<li class="passion">
							<svg class="passion-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								{b.icon === "piano" && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="M8 5v14M13 5v14M18 5v14" /><path d="M6.5 5v7h3V5M11.5 5v7h3V5" fill="currentColor" stroke="none" /></>}
								{b.icon === "leaf" && <><path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15" /><path d="M5 19c3-4 6-7 10-9" /></>}
								{b.icon === "design" && <><path d="M12 3l7 7-7 11-7-11z" /><circle cx="12" cy="11" r="2" /><path d="M12 3v6" /></>}
								{b.icon === "timetravel" && <><circle cx="12" cy="13" r="8" /><path d="M12 8v5l3 2" /><path d="M13.5 1.5 10 6h3.5L11 10" stroke-width="1.7" /></>}
								{b.icon === "stars" && <><path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6z" /><path d="M18.5 14.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8zM5.5 15l.6 1.6 1.6.6-1.6.6-.6 1.6-.6-1.6L3.3 17.2l1.6-.6z" /></>}
							</svg>
							<span class="fact-main">{b.label}</span>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<section id="music" class="wrap section">
		<header class="section-head framed music-head">
			<span class="mono">04</span>
			<h2>Music</h2>
			<p class="music-sub">Piano, melodica &amp; improvisation</p>
			<a class="sc-link" href={profile.soundcloud} target="_blank" rel="noopener noreferrer">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11 7.6a5 5 0 0 1 8.7 2.9A3.2 3.2 0 1 1 20.8 17H11zM9.2 9h1v8h-1zM7.4 10h1v7h-1zM5.6 9.5h1V17h-1zM3.8 11h1v6h-1zM2 12.5h1V17H2z" /></svg>
				SoundCloud <Arrow />
			</a>
		</header>
		<MusicGrid
			tracks={tracks.flatMap((t) => (t.data.url ? [{ title: t.data.title, url: t.data.url, note: t.data.note, edit: t.edit.title }] : []))}
		/>
	</section>

	<section id="contact" class="wrap section cta">
		<p class="mono">05 · Contact</p>
		<h2 class="cta-title">Let’s talk.</h2>
		<p class="cta-sub">The quickest way to reach me is LinkedIn.</p>
		<div class="intro-actions">
			<SocialButtons linkedin={linkedin} github={github} twitter={twitter} email={profile.email} center />
		</div>
	</section>
</Base>

<style>
	.wrap {
		max-width: var(--wide-width);
		margin-inline: auto;
		padding-inline: clamp(1rem, 4vw, var(--spacing-lg));
	}

	.intro {
		padding-block: clamp(1.5rem, 5vh, var(--spacing-3xl)) clamp(1.25rem, 3vh, var(--spacing-xl));
	}

	.intro-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: var(--spacing-md);
	}

	.pulse {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--color-brand);
		box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-brand) 50%, transparent);
		animation: pulse 2.4s ease-out infinite;
	}

	@keyframes pulse {
		to {
			box-shadow: 0 0 0 10px transparent;
		}
	}

	.intro-name {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
	}

	.intro-lede {
		margin-top: var(--spacing-md);
		max-width: 38rem;
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
	}

	.intro-actions {
		margin-top: var(--spacing-lg);
	}

	@media (min-width: 1024px) {
		.hero {
			display: grid;
			grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
			align-items: center;
			gap: var(--spacing-xl);
			min-height: calc(100svh - 4.5rem);
			padding-block: var(--spacing-xl);
		}

		.hero .intro {
			padding-block: 0;
		}

		.hero .intro-name {
			font-size: clamp(3rem, 1rem + 3.4vw, 4.5rem);
		}

		.hero-fig {
			margin-bottom: 0;
		}

		.hero-fig :global(.fig-svg) {
			max-height: min(76svh, 760px);
		}
	}

	.hero-fig {
		margin-bottom: clamp(2rem, 6vw, var(--spacing-3xl));
	}

	.section {
		padding-block: clamp(2rem, 6vw, var(--spacing-3xl));
	}

	.section-head {
		display: flex;
		align-items: baseline;
		gap: var(--spacing-md);
		margin-bottom: var(--spacing-xl);
	}

	/* Header cell on top of a grid: the grid itself is the section frame */
	.section-head.framed {
		margin-bottom: 0;
		padding: var(--spacing-md) var(--spacing-lg);
		border: 1px solid var(--color-border);
		border-bottom: 0;
	}

	.section-head .mono {
		color: var(--color-brand);
	}

	.section-head h2 {
		font-size: var(--font-size-xl);
		font-weight: 400;
		letter-spacing: -0.02em;
	}

	.section-link {
		margin-left: auto;
		text-decoration: none;
	}

	.section-link:hover {
		color: var(--color-text);
	}

	/* LangChain-style grid: hairline borders shared between cells */
	.roles {
		list-style: none;
	}

	.role {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
		min-height: 13.5rem;
	}

	.role-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--spacing-md);
		min-height: 2.5rem;
	}

	/* Company logos rendered as single-colour marks: white in dark, ink in light */
	.role-logo {
		height: 1.5rem;
		width: auto;
		max-width: 8.5rem;
		object-fit: contain;
		object-position: left center;
		filter: brightness(0) invert(1);
		opacity: 0.9;
	}

	/* square-ish marks need more height to read at the same weight */
	.role-logo[src$="01edu.png"] {
		height: 2.5rem;
	}

	@media (prefers-color-scheme: light) {
		:global(:root:not(.dark)) .role-logo {
			filter: brightness(0);
			opacity: 0.85;
		}
	}

	:global(:root.light) .role-logo {
		filter: brightness(0);
		opacity: 0.85;
	}

	.role-logo-text {
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.5rem;
	}

	.role-when {
		text-transform: none;
		letter-spacing: 0.02em;
		white-space: nowrap;
		font-size: 0.68rem;
		padding-top: 0.2rem;
	}

	.role-title {
		font-size: var(--font-size-base);
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.35;
	}

	.role-at {
		margin-top: 0.25rem;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.role-at a {
		text-decoration: none;
		color: var(--color-text);
		transition: color var(--transition-fast);
	}

	.role-at a:hover {
		color: var(--color-brand);
	}

	.role-stack {
		margin-top: auto;
		padding-top: var(--spacing-sm);
		border-top: 1px dashed var(--color-border);
		font-size: 0.66rem;
		text-transform: none;
		letter-spacing: 0.04em;
		line-height: 1.6;
	}


	.skills {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
	}

	.skills li {
		font-family: var(--font-mono), ui-monospace, monospace;
		font-size: var(--font-size-sm);
		padding: 0.4rem 0.85rem;
		border: 1px solid color-mix(in srgb, var(--color-brand) 30%, var(--color-border));
		background: color-mix(in srgb, var(--color-brand) 7%, transparent);
		border-radius: 999px;
		color: var(--color-text);
	}

	.cta {
		text-align: center;
		padding-bottom: clamp(3rem, 8vw, var(--spacing-4xl));
	}

	.cta > .mono {
		color: var(--color-brand);
	}

	.cta-title {
		margin-top: var(--spacing-md);
		font-size: var(--font-size-3xl);
		font-weight: 300;
		letter-spacing: var(--tracking-tight);
	}

	.cta-sub {
		margin-top: var(--spacing-sm);
		color: var(--color-muted);
	}

	.music-head {
		flex-wrap: wrap;
		align-items: center;
	}

	.music-sub {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.sc-link {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.sc-link svg:first-child {
		width: 1.1rem;
		height: 1.1rem;
		color: #ff5500;
	}

	.sc-link:hover {
		color: var(--color-text);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.about {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, var(--spacing-3xl));
	}

	.about-text {
		max-width: 42rem;
		line-height: var(--leading-relaxed);
	}

	.about-text :global(p) {
		margin-bottom: 1.1em;
	}

	.about-text :global(h2) {
		font-size: var(--font-size-lg);
		font-weight: 500;
		margin: 1.8em 0 0.5em;
	}

	.facts {
		margin-top: var(--spacing-2xl);
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
	}

	.fact ul {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.fact-label {
		margin-bottom: var(--spacing-md);
		color: var(--color-brand);
	}

	.fact li {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.fact .langs li {
		flex-direction: row;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding-bottom: var(--spacing-sm);
		border-bottom: 1px dashed var(--color-border);
	}

	.fact .langs {
		gap: var(--spacing-sm);
	}

	.fact .langs li:last-child {
		border-bottom: 0;
	}

	.fact li.passion {
		flex-direction: row;
		align-items: center;
		gap: var(--spacing-sm);
	}

	.passion-icon {
		flex: none;
		width: 1.15rem;
		height: 1.15rem;
		color: var(--color-brand);
	}

	.fact-main {
		font-size: var(--font-size-sm);
		font-weight: 500;
	}

	.fact-sub {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.fact-meta {
		font-size: 0.64rem;
		text-transform: none;
		letter-spacing: 0.04em;
	}

	.about-label {
		margin-bottom: var(--spacing-md);
	}

	@media (max-width: 720px) {
		.about {
			grid-template-columns: 1fr;
		}

	}

</style>
