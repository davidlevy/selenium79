---
interface Props {
	linkedin?: string;
	github?: string;
	email?: string;
	soundcloud?: string;
	center?: boolean;
}
const { linkedin, github, email, soundcloud, center } = Astro.props;
---

<div class:list={["social", { center }]}>
	{
		linkedin && (
			<a class="sbtn sbtn-linkedin" href={linkedin} target="_blank" rel="noopener noreferrer">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"
					/>
				</svg>
				LinkedIn
			</a>
		)
	}
	{
		github && (
			<a class="sbtn sbtn-github" href={github} target="_blank" rel="noopener noreferrer">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57l-.02-2.04c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3"
					/>
				</svg>
				GitHub
			</a>
		)
	}
	{
		soundcloud && (
			<a class="sbtn sbtn-soundcloud" href={soundcloud} target="_blank" rel="noopener noreferrer">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M11 7.6a5 5 0 0 1 8.7 2.9A3.2 3.2 0 1 1 20.8 17H11zM9.2 9h1v8h-1zM7.4 10h1v7h-1zM5.6 9.5h1V17h-1zM3.8 11h1v6h-1zM2 12.5h1V17H2z"
					/>
				</svg>
				SoundCloud
			</a>
		)
	}
	{
		email && (
			<a class="sbtn sbtn-mail" href={`mailto:${email}`}>
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="5" width="18" height="14" rx="2.5" />
					<path d="m4 7 8 6 8-6" />
				</svg>
				<span class="sbtn-mail-text">{email}</span>
			</a>
		)
	}
</div>

<style>
	.social {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
	}

	.social.center {
		justify-content: center;
	}

	.sbtn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		min-height: 2.75rem;
		padding: 0.6rem 1.15rem;
		border-radius: 999px;
		border: 1px solid transparent;
		font-size: var(--font-size-sm);
		font-weight: 500;
		text-decoration: none;
		transition:
			transform var(--transition-fast),
			filter var(--transition-fast),
			background var(--transition-fast);
	}

	.sbtn svg {
		width: 1.05rem;
		height: 1.05rem;
		flex: none;
	}

	.sbtn:hover {
		transform: translateY(-1px);
		filter: brightness(1.08);
	}

	.sbtn:focus-visible {
		outline: 2px solid var(--color-brand);
		outline-offset: 2px;
	}

	.sbtn-linkedin {
		background: #0a66c2;
		color: #fff;
	}

	.sbtn-github {
		background: light-dark(#1f2328, #eef1f5);
		color: light-dark(#fff, #1f2328);
	}

	.sbtn-soundcloud {
		background: #ff5500;
		color: #fff;
	}

	.sbtn-mail {
		background: color-mix(in srgb, var(--color-brand) 14%, transparent);
		border-color: color-mix(in srgb, var(--color-brand) 40%, transparent);
		color: var(--color-text);
		min-width: 0;
	}

	.sbtn-mail-text {
		overflow-wrap: anywhere;
	}

	@media (max-width: 480px) {
		.sbtn {
			flex: 1 1 auto;
		}
	}
</style>
