---
// Isometric wireframe drawings of gear, in the same line style as the hero.
// Geometry is generated at render time: x runs down-right, y (depth) up-right, z up.
interface Props {
	kind: "korg-x5" | "atari-st" | "delorean" | "yamaha-qx5" | "3m-mouse" | "boox-nova3";
	label: string;
}
const { kind, label } = Astro.props;

const C = Math.cos(Math.PI / 6);
const U = 14; // px per unit
type V = [number, number, number];
const P = ([x, y, z]: V): [number, number] => [(x + y) * C * U, ((x - y) * 0.5 - z) * U];
const all: [number, number][] = [];
const pt = (v: V) => {
	const p = P(v);
	all.push(p);
	return `${p[0].toFixed(1)},${p[1].toFixed(1)}`;
};
const out: string[] = [];
const poly = (vs: V[], cls = "w") => out.push(`<polygon class="${cls}" points="${vs.map(pt).join(" ")}"/>`);
const line = (a: V, b: V, cls = "l") => {
	const [p, q] = [P(a), P(b)];
	all.push(p, q);
	out.push(`<line class="${cls}" x1="${p[0].toFixed(1)}" y1="${p[1].toFixed(1)}" x2="${q[0].toFixed(1)}" y2="${q[1].toFixed(1)}"/>`);
};
/** Visible faces of an axis-aligned box: front (y0), right (x1), top. */
const box = (x0: number, y0: number, z0: number, w: number, d: number, h: number, cls = "w", topCls = cls) => {
	const [x1, y1, z1] = [x0 + w, y0 + d, z0 + h];
	poly([[x0, y0, z1], [x1, y0, z1], [x1, y0, z0], [x0, y0, z0]], cls);
	poly([[x1, y0, z1], [x1, y1, z1], [x1, y1, z0], [x1, y0, z0]], cls);
	poly([[x0, y0, z1], [x1, y0, z1], [x1, y1, z1], [x0, y1, z1]], topCls);
};
/** Text sheared onto a plane: along x, "down" towards -y (top) or -z (front). */
const text = (s: string, at: V, size: number, plane: "top" | "front", cls = "t") => {
	const o = P(at);
	const m =
		plane === "top"
			? `matrix(${C * U},${0.5 * U},${-C * U},${0.5 * U},${o[0].toFixed(1)},${o[1].toFixed(1)})`
			: `matrix(${C * U},${0.5 * U},0,${U},${o[0].toFixed(1)},${o[1].toFixed(1)})`;
	out.push(`<text class="${cls}" font-size="${size}" transform="${m}">${s}</text>`);
};
/** Circle in the x–z plane at depth y (a wheel seen from the front face). */
const wheel = (cx: number, y: number, cz: number, r: number) => {
	const ring = (rr: number, cls: string) => {
		const vs: V[] = [];
		for (let i = 0; i < 28; i++) {
			const a = (i / 28) * Math.PI * 2;
			vs.push([cx + rr * Math.cos(a), y, cz + rr * Math.sin(a)]);
		}
		poly(vs, cls);
	};
	ring(r, "w");
	ring(r * 0.55, "w s");
	ring(r * 0.18, "f");
};

if (kind === "korg-x5") {
	// Korg X5 (1994): 61-key synth, LCD + button panel at the back
	const W = 18, D = 5.4;
	box(0, 0, 0, W, D, 0.9);
	poly([[0.4, 0.25, 0.9], [W - 0.4, 0.25, 0.9], [W - 0.4, 3.05, 0.9], [0.4, 3.05, 0.9]], "w s"); // key bed
	const n = 36, kw = (W - 0.8) / n;
	for (let i = 1; i < n; i++) line([0.4 + i * kw, 0.25, 0.9], [0.4 + i * kw, 3.05, 0.9]);
	const black = [1, 2, 4, 5, 6];
	for (let o = 0; o < 5; o++)
		for (const b of black) {
			const x = 0.4 + (o * 7 + b) * kw - kw * 0.3;
			box(x, 1.45, 0.9, kw * 0.6, 1.6, 0.22, "w k");
		}
	poly([[6, 3.55, 0.9], [9.8, 3.55, 0.9], [9.8, 4.75, 0.9], [6, 4.75, 0.9]], "w lcd"); // LCD
	text("PROG A.01  Grand Piano", [6.25, 3.85, 0.9], 0.34, "top", "t lcd-t");
	for (let r = 0; r < 2; r++)
		for (let c = 0; c < 8; c++) box(10.5 + c * 0.75, 3.55 + r * 0.7, 0.9, 0.45, 0.4, 0.1, "w");
	line([1.2, 3.7, 0.9], [1.2, 4.9, 0.9], "l s"); // volume slider
	box(1.0, 4.1, 0.9, 0.4, 0.3, 0.15, "w");
	box(2.3, 3.8, 0.9, 0.9, 0.9, 0.15, "w"); // joystick base
	line([2.75, 4.25, 1.05], [3.05, 4.55, 1.85], "l s");
	text("KORG", [3.8, 3.75, 0.9], 0.42, "top", "t b");
	text("X5", [3.8, 4.55, 0.9], 0.5, "top", "t acc");
}

if (kind === "atari-st") {
	// Atari 520 ST (1985): wedge keyboard computer, slanted F-keys, built-in MIDI; mouse on the side
	const W = 14, D = 6.2, zf = 0.55, zb = 1.25;
	const zAt = (y: number) => zf + ((zb - zf) * y) / D;
	poly([[0, 0, zf], [W, 0, zf], [W, 0, 0], [0, 0, 0]]);
	poly([[W, 0, zf], [W, D, zb], [W, D, 0], [W, 0, 0]]);
	poly([[0, 0, zf], [W, 0, zf], [W, D, zb], [0, D, zb]]);
	const key = (x: number, y: number, w: number, d: number, skew = 0, cls = "w") => {
		const z0 = zAt(y), z1 = zAt(y + d);
		poly([[x, y, z0 + 0.08], [x + w, y, z0 + 0.08], [x + w + skew, y + d, z1 + 0.08], [x + skew, y + d, z1 + 0.08]], cls);
	};
	for (let r = 0; r < 5; r++) {
		const cols = [13, 13, 12, 11, 1][r];
		const y = 0.5 + r * 0.82;
		if (r === 4) {
			key(2.2, y, 6.2, 0.62); // space bar
			continue;
		}
		const off = 0.5 + r * 0.25;
		for (let c = 0; c < cols; c++) key(off + c * 0.72, y, 0.6, 0.62);
	}
	for (let c = 0; c < 10; c++) key(0.6 + c * 0.95, 4.85, 0.8, 0.45, 0.35); // slanted function keys
	for (let r = 0; r < 4; r++) for (let c = 0; c < 3; c++) key(10.4 + c * 0.72, 0.5 + r * 0.82, 0.6, 0.62);
	text("ATARI", [10.3, 5.0, zAt(5.0)], 0.48, "top", "t b");
	text("520 ST", [12.1, 5.0, zAt(5.0)], 0.36, "top", "t acc");
	// MIDI IN/OUT on the right side
	for (const y of [3.4, 4.4]) {
		const vs: V[] = [];
		for (let i = 0; i < 20; i++) {
			const a = (i / 20) * Math.PI * 2;
			vs.push([W, y + 0.28 * Math.cos(a), 0.45 + 0.28 * Math.sin(a)]);
		}
		poly(vs, "w s");
	}
	// mouse with cable
	box(W + 1.4, 1.0, 0, 1.3, 2.0, 0.45, "w", "w");
	line([W + 1.4, 2.25, 0.45], [W + 2.7, 2.25, 0.45], "l s");
	const a = P([W + 2.05, 3.0, 0.3]), b = P([W, 5.6, 0.6]);
	all.push(a, b);
	out.push(`<path class="l s" d="M${a[0].toFixed(1)},${a[1].toFixed(1)} C${(a[0] + 30).toFixed(1)},${(a[1] - 40).toFixed(1)} ${(b[0] + 40).toFixed(1)},${(b[1] + 10).toFixed(1)} ${b[0].toFixed(1)},${b[1].toFixed(1)}"/>`);
}

if (kind === "delorean") {
	// DeLorean DMC-12 (1981): wedge nose, wheel arches, louvred rear, both gull-wing
	// doors up, Mr. Fusion on the deck, OUTATIME plate and fire trails behind.
	const L = 12.5, Wd = 4.8, zb = 0.6, zh = 1.35, zd = 1.95, xh = 2.9;
	const wheels = [2.4, 10.1], r = 0.95, wz = 0.88;
	const topZ = (x: number) => (x < xh ? zh + ((zd - zh) * x) / xh : zd);
	// fire trails on the road (drawn first, the car covers them)
	for (const y of [0.25, Wd - 0.25]) {
		line([wheels[1], y, 0], [L + 3.6, y, 0], "l fire");
		line([wheels[1] + 0.4, y + 0.18, 0], [L + 2.8, y + 0.18, 0], "l fire thin");
	}
	// far gull-wing door (behind the roof)
	const xa = 4.9, xb = 7.3;
	poly([[xa, Wd - 0.95, 3.05], [xb, Wd - 0.95, 3.05], [xb, Wd + 0.5, 3.95], [xa, Wd + 0.5, 3.95]], "w s");
	poly([[xa, Wd + 0.5, 3.95], [xb, Wd + 0.5, 3.95], [xb, Wd + 1.2, 3.05], [xa, Wd + 1.2, 3.05]], "w s");
	// body: rear face, deck + hood, side with arches
	poly([[L, 0, zb], [L, Wd, zb], [L, Wd, zd], [L, 0, zd]]);
	poly([[0, 0, zh], [xh, 0, zd], [xh, Wd, zd], [0, Wd, zh]]); // hood
	poly([[xh, 0, zd], [L, 0, zd], [L, Wd, zd], [xh, Wd, zd]]); // deck
	const side: V[] = [[0, 0, zb], [0, 0, zh], [xh, 0, zd], [L, 0, zd], [L, 0, zb]];
	for (const cx of [...wheels].reverse()) {
		for (let k = 0; k <= 12; k++) {
			const a = (k / 12) * Math.PI;
			side.push([cx + (r + 0.18) * Math.cos(a), 0, wz + (r + 0.18) * Math.sin(a) * 0.95]);
		}
	}
	poly(side);
	line([0.3, 0, 1.18], [L - 0.2, 0, 1.18], "l s"); // the DMC crease
	line([0.2, 0, 0.72], [L - 0.2, 0, 0.72], "l s"); // rocker
	// cabin: windshield, roof, louvred rear slope
	const cb = { xf: 3.3, xr: 10.4, xrf: 5.0, xrr: 7.4, yi: 0.45, yr: 0.95, zr: 3.05 };
	poly([[cb.xf, cb.yi, zd], [cb.xr, cb.yi, zd], [cb.xrr, cb.yr, cb.zr], [cb.xrf, cb.yr, cb.zr]]); // near side
	poly([[cb.xr, cb.yi, zd], [cb.xr, Wd - cb.yi, zd], [cb.xrr, Wd - cb.yr, cb.zr], [cb.xrr, cb.yr, cb.zr]]); // rear slope
	poly([[cb.xrf, cb.yr, cb.zr], [cb.xrr, cb.yr, cb.zr], [cb.xrr, Wd - cb.yr, cb.zr], [cb.xrf, Wd - cb.yr, cb.zr]]); // roof
	for (let i = 1; i <= 7; i++) {
		const f = i / 8;
		const x = cb.xr + (cb.xrr - cb.xr) * f, z = zd + (cb.zr - zd) * f, y = cb.yi + (cb.yr - cb.yi) * f;
		line([x, y + 0.2, z], [x, Wd - y - 0.2, z], "l s"); // louvres
	}
	// near gull-wing door, open like a wing
	poly([[xa, cb.yr, cb.zr], [xb, cb.yr, cb.zr], [xb, -0.55, 3.95], [xa, -0.55, 3.95]], "w door");
	poly([[xa + 0.25, cb.yr - 0.15, cb.zr + 0.08], [xb - 0.25, cb.yr - 0.15, cb.zr + 0.08], [xb - 0.25, -0.3, 3.8], [xa + 0.25, -0.3, 3.8]], "w s");
	poly([[xa, -0.55, 3.95], [xb, -0.55, 3.95], [xb, -1.25, 3.05], [xa, -1.25, 3.05]], "w door");
	// Mr. Fusion on the rear deck
	box(L - 1.45, Wd / 2 - 0.3, zd, 0.6, 0.6, 0.55, "w", "w k");
	line([L - 1.15, Wd / 2, zd + 0.55], [L - 1.15, Wd / 2, zd + 0.85], "l");
	// rear: tail-light grilles + plate
	for (const [y0, y1] of [[0.35, 1.55], [Wd - 1.55, Wd - 0.35]]) {
		poly([[L, y0, 1.45], [L, y1, 1.45], [L, y1, 1.75], [L, y0, 1.75]], "w s");
		for (let k = 1; k < 5; k++) line([L, y0 + ((y1 - y0) * k) / 5, 1.45], [L, y0 + ((y1 - y0) * k) / 5, 1.75], "l s");
	}
	poly([[L, 1.75, 0.75], [L, Wd - 1.75, 0.75], [L, Wd - 1.75, 1.25], [L, 1.75, 1.25]], "w s");
	const o = P([L, 1.85, 0.88]);
	all.push(o);
	out.push(`<text class="t acc" font-size="0.36" transform="matrix(${(C * U).toFixed(2)},${(-0.5 * U).toFixed(2)},0,${U},${o[0].toFixed(1)},${o[1].toFixed(1)})">OUTATIME</text>`);
	// wheels with spokes
	for (const cx of wheels) {
		wheel(cx, -0.06, wz, r);
		for (let k = 0; k < 5; k++) {
			const a = (k / 5) * Math.PI * 2 + 0.3;
			line([cx + 0.18 * Math.cos(a), -0.08, wz + 0.18 * Math.sin(a)], [cx + 0.5 * Math.cos(a), -0.08, wz + 0.5 * Math.sin(a)], "l s");
		}
	}
	// flux sparks off the rear
	for (const [dy, dz] of [[0.6, 0.0], [1.6, 0.35], [2.6, 0.1]]) line([L, dy + 0.4, zd], [L + 0.9, dy + 0.1, zd + 0.7 + dz], "l acc-l");
}

if (kind === "yamaha-qx5") {
	// Yamaha QX5 (1986): digital sequence recorder — sloped front panel, LCD, transport keys
	const W = 13, D = 8, zf = 0.4, zt = 1.1, ys = 2.9;
	poly([[0, 0, zf], [W, 0, zf], [W, 0, 0], [0, 0, 0]]);
	poly([[W, 0, zf], [W, ys, zt], [W, D, zt], [W, D, 0], [W, 0, 0]]);
	poly([[0, ys, zt], [W, ys, zt], [W, D, zt], [0, D, zt]]); // top
	poly([[0, 0, zf], [W, 0, zf], [W, ys, zt], [0, ys, zt]]); // sloped panel
	const zAt = (y: number) => zf + ((zt - zf) * y) / ys;
	const pad = (x: number, y: number, w: number, d: number, cls = "w") =>
		poly([[x, y, zAt(y) + 0.06], [x + w, y, zAt(y) + 0.06], [x + w, y + d, zAt(y + d) + 0.06], [x, y + d, zAt(y + d) + 0.06]], cls);
	pad(0.8, 0.5, 2.6, 1.0, "w lcd");
	text("SONG 01  BAR 017", [0.95, 0.75, zAt(0.75) + 0.06], 0.26, "top", "t lcd-t");
	text("YAMAHA", [0.8, 1.85, zAt(1.85)], 0.34, "top", "t b");
	text("QX5", [2.75, 1.85, zAt(1.85)], 0.42, "top", "t acc");
	for (let r = 0; r < 3; r++) for (let c = 0; c < 7; c++) pad(4.2 + c * 0.62, 0.45 + r * 0.72, 0.4, 0.32);
	for (let c = 0; c < 3; c++) pad(9.2 + c * 1.15, 0.9, 0.85, 0.85, c === 1 ? "w lcd" : "w k");
	// printed reference chart on the top panel
	poly([[1, 3.6, zt], [8.5, 3.6, zt], [8.5, 7.2, zt], [1, 7.2, zt]], "w s");
	for (let i = 1; i < 6; i++) line([1.3, 3.6 + i * 0.6, zt], [8.2 - (i % 2) * 1.6, 3.6 + i * 0.6, zt]);
	line([4.7, 3.7, zt], [4.7, 7.1, zt], "l s");
	// MIDI cable out the back
	const a = P([W, 6.5, 0.6]), b = P([W + 3, 9, 0.2]);
	all.push(a, b);
	out.push(`<path class="l s" d="M${a[0].toFixed(1)},${a[1].toFixed(1)} C${(a[0] + 30).toFixed(1)},${(a[1] + 5).toFixed(1)} ${(b[0] - 10).toFixed(1)},${(b[1] - 30).toFixed(1)} ${b[0].toFixed(1)},${b[1].toFixed(1)}"/>`);
}

if (kind === "3m-mouse") {
	// 3M Ergonomic Mouse: a joystick-style vertical mouse. Rounded base, a tilted
	// handle drawn as a solid of revolution (rings + silhouettes), buttons on top,
	// coiled cable ending in a USB plug.
	const cx = 3.2, cy = 3.0, bz = 0.55;
	// base: superellipse footprint extruded; bottom first, top over it
	const base = (z: number, grow = 0): V[] =>
		Array.from({ length: 48 }, (_, i) => {
			const a = (i / 48) * Math.PI * 2;
			const c = Math.cos(a), sn = Math.sin(a);
			const rx = 2.9 + grow, ry = 2.5 + grow;
			return [cx + rx * Math.sign(c) * Math.abs(c) ** 0.7, cy + ry * Math.sign(sn) * Math.abs(sn) ** 0.7, z] as V;
		});
	// cable first (behind everything): coil + plug
	const coil: string[] = [];
	for (let k = 0; k < 3; k++) {
		const ring: V[] = Array.from({ length: 30 }, (_, i) => {
			const a = (i / 30) * Math.PI * 2;
			return [6.6 + 0.9 * Math.cos(a) + k * 0.15, 6.3 + 0.55 * Math.sin(a) + k * 0.1, 0.05] as V;
		});
		coil.push(`<polygon class="l s" points="${ring.map(pt).join(" ")}" fill="none"/>`);
	}
	out.push(...coil);
	const c0 = P([cx + 0.6, cy + 2.4, 0.3]), c1 = P([6.2, 6.0, 0.05]);
	all.push(c0, c1);
	out.push(`<path class="l s" d="M${c0[0].toFixed(1)},${c0[1].toFixed(1)} C${(c0[0] + 20).toFixed(1)},${(c0[1] - 12).toFixed(1)} ${(c1[0] - 25).toFixed(1)},${(c1[1] + 6).toFixed(1)} ${c1[0].toFixed(1)},${c1[1].toFixed(1)}"/>`);
	line([7.6, 6.3, 0.05], [8.9, 5.2, 0.05], "l s");
	box(8.9, 4.4, 0, 1.0, 0.7, 0.35, "w"); // USB plug
	box(9.9, 4.55, 0.07, 0.55, 0.4, 0.2, "w s");
	poly(base(0, 0.05), "w");
	poly(base(bz), "w");
	{
		const top = base(bz).map(P), bot = base(0, 0.05).map(P);
		const iMin = top.reduce((m, p, i) => (p[0] < top[m][0] ? i : m), 0);
		const iMax = top.reduce((m, p, i) => (p[0] > top[m][0] ? i : m), 0);
		for (const i of [iMin, iMax]) {
			all.push(top[i], bot[i]);
			out.push(`<line class="l" x1="${top[i][0].toFixed(1)}" y1="${top[i][1].toFixed(1)}" x2="${bot[i][0].toFixed(1)}" y2="${bot[i][1].toFixed(1)}"/>`);
		}
	}
	// handle: axis leans forward (−x) as it rises; radius profile with a flared foot and a bulb
	const H = 5.4, steps = 28;
	const axis = (t: number): V => [cx - 0.2 - 0.9 * t * t, cy + 0.15 * t, bz + H * t];
	const rad = (t: number) => {
		const foot = 1.05 * Math.exp(-((t / 0.09) ** 2));
		const bulb = 0.28 * Math.exp(-(((t - 0.78) / 0.14) ** 2));
		const cap = t > 0.9 ? Math.sqrt(Math.max(0, 1 - ((t - 0.9) / 0.1) ** 2)) : 1;
		return (0.55 + foot + bulb) * cap;
	};
	const ring = (t: number): V[] => {
		const a0 = axis(t), r = rad(t);
		return Array.from({ length: 36 }, (_, i) => {
			const a = (i / 36) * Math.PI * 2;
			return [a0[0] + r * Math.cos(a), a0[1] + r * Math.sin(a), a0[2]] as V;
		});
	};
	const left: [number, number][] = [], right: [number, number][] = [];
	for (let k = 0; k <= steps; k++) {
		const pts = ring(k / steps).map(P);
		let l = pts[0], r = pts[0];
		for (const q of pts) {
			if (q[0] < l[0]) l = q;
			if (q[0] > r[0]) r = q;
		}
		left.push(l);
		right.push(r);
	}
	// close the outline along the front half of the foot ring (not a straight chord)
	const footC = P(axis(0));
	const footFront = ring(0).map(P).filter((q) => q[1] >= footC[1]).sort((a, b) => b[0] - a[0]);
	const sil = [...left, ...right.reverse(), ...footFront];
	all.push(...sil);
	out.push(`<polygon class="w" points="${sil.map((q) => `${q[0].toFixed(1)},${q[1].toFixed(1)}`).join(" ")}"/>`);
	// a few cross-section rings (front halves only) give the volume
	for (const t of [0.12, 0.3, 0.48, 0.64, 0.8]) {
		const pts = ring(t);
		const c = P(axis(t));
		const front = pts.map(P).filter((q) => q[1] >= c[1]);
		out.push(`<polyline class="l s" points="${front.sort((a, b) => a[0] - b[0]).map((q) => `${q[0].toFixed(1)},${q[1].toFixed(1)}`).join(" ")}"/>`);
	}
	// two buttons on the surface of the bulb, facing the viewer
	const patch = (t0: number, t1: number, a0: number, a1: number): V[] => {
		const arc = (t: number, rev: boolean) => {
			const ax = axis(t), r = rad(t) + 0.02;
			const pts = Array.from({ length: 8 }, (_, i) => {
				const a = ((a0 + ((a1 - a0) * i) / 7) * Math.PI) / 180;
				return [ax[0] + r * Math.cos(a), ax[1] + r * Math.sin(a), ax[2]] as V;
			});
			return rev ? pts.reverse() : pts;
		};
		return [...arc(t0, false), ...arc(t1, true)];
	};
	poly(patch(0.7, 0.77, 215, 275), "w s");
	poly(patch(0.79, 0.86, 215, 275), "w s");
	const tw = axis(0.93);
	const wh: V[] = Array.from({ length: 20 }, (_, i) => {
		const a = (i / 20) * Math.PI * 2;
		return [tw[0] - 0.3 + 0.32 * Math.cos(a), tw[1], tw[2] + 0.28 * Math.sin(a)] as V;
	});
	poly(wh, "w acc-w");
	text("3M", [cx + 0.3, cy - 2.05, bz], 0.65, "top", "t b");
}

if (kind === "boox-nova3") {
	// Onyx Boox Nova3 Color (2021): 7.8" colour e-ink tablet lying flat, with its stylus
	const W = 6.6, D = 9, H = 0.25;
	box(0, 0, 0, W, D, H);
	const [x0, x1, y0, y1] = [0.45, W - 0.45, 1.05, D - 0.45];
	poly([[x0, y0, H], [x1, y0, H], [x1, y1, H], [x0, y1, H]], "w s"); // screen
	// the cover art: a quilt of squares, a few tiles tinted (colour e-ink)
	const cols = 5, rows = 7, cw = (x1 - x0) / cols, rh = (y1 - 0.9 - y0) / rows;
	for (let r = 0; r < rows; r++)
		for (let c = 0; c < cols; c++) {
			if ((r + c) % 3 !== 0) continue;
			const [a, b] = [x0 + c * cw, y0 + r * rh];
			poly([[a, b, H], [a + cw, b, H], [a + cw, b + rh, H], [a, b + rh, H]], (r * cols + c) % 2 ? "w tint" : "w s");
		}
	text("BOOX", [W / 2 - 0.55, y1 - 0.3, H], 0.42, "top", "t b");
	poly([[W / 2 - 0.5, 0.35, H], [W / 2 + 0.5, 0.35, H], [W / 2 + 0.5, 0.6, H], [W / 2 - 0.5, 0.6, H]], "w s"); // home button
	// stylus beside it
	box(W + 0.7, 1.2, 0, 0.32, 6.6, 0.32, "w", "w k");
	line([W + 0.86, 1.2, 0.16], [W + 0.86, 0.6, 0.16], "l");
	line([W + 0.7, 6.2, 0.32], [W + 1.02, 6.2, 0.32], "l");
}

const xs = all.map((p) => p[0]), ys = all.map((p) => p[1]);
const pad = 10;
const vb = [Math.min(...xs) - pad, Math.min(...ys) - pad, Math.max(...xs) - Math.min(...xs) + pad * 2, Math.max(...ys) - Math.min(...ys) + pad * 2]
	.map((v) => v.toFixed(0))
	.join(" ");
---

<svg class="gear-art" viewBox={vb} role="img" aria-label={`Wireframe drawing: ${label}`}>
	<Fragment set:html={out.join("")} />
</svg>

<style>
