		stroke-width: 1;
		vector-effect: non-scaling-stroke;
		stroke-opacity: 0.55;
		fill: none;
	}

	.gear-art :global(.f) {
		fill: currentColor;
		stroke: none;
		opacity: 0.6;
	}

	.gear-art :global(.lcd) {
		fill: color-mix(in srgb, var(--color-brand) 10%, var(--color-bg));
