		stroke-opacity: 0.8;
		stroke-dasharray: 6 4;
	}

	.gear-art :global(.fire.thin) {
		stroke-opacity: 0.45;
		stroke-dasharray: 3 5;
	}

	.gear-art :global(.ghost) {
		fill: none;
		stroke-opacity: 0.3;
		stroke-dasharray: 2 3;
