		fill: var(--color-bg);
		stroke: currentColor;
		stroke-width: 1;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
		transition: stroke 200ms ease;
	}

	.gear-art :global(.s) {
		stroke-opacity: 0.6;
	}

	.gear-art :global(.k) {
