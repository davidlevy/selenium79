---
// Lite YouTube embed: a thumbnail + play button that swaps in the
// (privacy-enhanced) player only when clicked.
interface Props {
	url: string;
	title: string;
	ratio?: string; // CSS aspect-ratio
}
const { url, title, ratio = "16 / 9" } = Astro.props;
// id from watch?v=, youtu.be/ or /embed/ URLs
const id = url.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/)?.[1];
---

{
	id && (
		<div class="yt" data-yt={id} data-title={title} style={`aspect-ratio: ${ratio}`}>
			<button type="button" class="yt-play" aria-label={`Play video: ${title}`}>
				<img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
				<span class="yt-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path fill="currentColor" d="M8 5.5v13l11-6.5z" /></svg>
				</span>
			</button>
		</div>
	)
}

<script>
	document.addEventListener("click", (e) => {
		const btn = (e.target as Element).closest<HTMLButtonElement>(".yt-play");
		const box = btn?.closest<HTMLElement>("[data-yt]");
		if (!box) return;
		const f = document.createElement("iframe");
		f.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
		f.title = box.dataset.title || "Video";
		f.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
		f.allowFullscreen = true;
		box.replaceChildren(f);
	});
</script>

<style>
	.yt {
		position: relative;
		overflow: hidden;
		border-radius: 6px;
		background: #000;
	}

	.yt :global(iframe),
	.yt-play {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.yt-play {
		position: relative;
		padding: 0;
		background: none;
		cursor: pointer;
	}

	.yt-play img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.82;
		transition:
			opacity var(--transition-base),
			transform var(--transition-slow);
	}

	.yt-icon {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 3.25rem;
		height: 3.25rem;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: color-mix(in srgb, #000 55%, transparent);
		border: 1px solid rgb(255 255 255 / 0.6);
		color: #fff;
		backdrop-filter: blur(6px);
		transition:
			transform var(--transition-base),
			background var(--transition-base);
	}

	.yt-icon svg {
		width: 1.3rem;
		height: 1.3rem;
		margin-left: 3px;
	}

	.yt-play:hover img {
		opacity: 1;
		transform: scale(1.03);
	}

	.yt-play:hover .yt-icon {
		transform: scale(1.08);
		background: #ff0033;
	}

	.yt-play:focus-visible {
		outline: 2px solid var(--color-brand);
		outline-offset: 2px;
	}
</style>
